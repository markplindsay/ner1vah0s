{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "preserve",
    "moduleDetection": "force",
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "rootDir": "./src",
    "strict": true
  },
  "exclude": ["dist", "src/**/*.test.ts"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
